<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="Openbox 3">
    <item label="Firefox">
      <action name="Execute">
        <command>firefox</command>
      </action>
    </item>
    <!-- already notified -->
    <item label="Terminal">
      <action name="Execute">
        <command>xterm</command>
        <startupnotify>
          <enabled>no</enabled>
        </startupnotify>
      </action>
    </item>
    <menu id="apps-editors" label="Editors">
      <item label="GIMP">
        <action name="Execute">
          <command>gimp</command>
        </action>
      </item>
    </menu>
    <item label="Exit">
      <action name="Exit"/>
    </item>
  </menu>
</openbox_menu>
